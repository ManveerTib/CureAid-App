{
  "appId": "com.cureaid.app",
  "appName": "CureAid",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "backgroundColor": "#091D2E",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#091D2E"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#091D2E",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#091D2E",
      "overlaysWebView": false
    }
  }
}
